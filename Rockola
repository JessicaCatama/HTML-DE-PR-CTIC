<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EL CATATUMBO - Rockola Digital</title>
    
    <link rel="stylesheet" href="style.css">
</head>

<body>

<header>
    <h1>EL CATATUMBO</h1>

    <div class="creadores">
        <img src="yupi.jpg" class="foto-perfil">
        <img src="rocolita.jpg" class="foto-perfil">
    </div>

    <p class="subtitulo">¡Creadores de esta rockola!</p>

    <div class="nombres">
        <h4 class="texto-creadores">Jessica Catama</h4>
        <h4 class="texto-creadores">Alejandro Parra</h4>
    </div>
</header>

<nav>
    <h4>Elige la categoría</h4>
    <ul>
        <li><a href="#Canciones">Rancheras</a></li>
        <li><a href="#Canciones2">Llanero</a></li>
        <li><a href="#Canciones3">Rock</a></li>
        <li><a href="#videoclips">Videoclips</a></li>
    </ul>
</nav>

<section id="Canciones" class="galeria">
    <h2>Rancheras</h2>

    <div class="contenedor-cards">

        <div class="card">
            <p class="titulo-cancion">Jeison Jimenez - Se acabó</p>
            <a href="https://www.youtube.com/watch?v=NqTKZJkiDWQ" target="_blank">
                <img src="seacabo.jpg" class="portada">
            </a>
            <div class="audio-wrapper">
                <audio controls>
                    <source src="audio/seacabo.mp3">
                </audio>
            </div>
        </div>

    </div>
</section>

<section id="Canciones2" class="galeria">
    <h2>Llanero</h2>

    <div class="contenedor-cards">

        <div class="card">
            <p class="titulo-cancion">Luis Silva - Como No Voy a Decirlo</p>
            <a href="https://www.youtube.com/watch?v=gXBWmWq9FsU" target="_blank">
                <img src="luissilva.jpg" class="portada">
            </a>
            <div class="audio-wrapper">
                <audio controls>
                    <source src="audio/luissilva.mp3">
                </audio>
            </div>
        </div>

    </div>
</section>

<section id="Canciones3" class="galeria">
    <h2>Rock</h2>

    <div class="contenedor-cards">

        <div class="card">
            <p class="titulo-cancion">Mago de Oz - Fiesta pagana</p>
            <a href="https://www.youtube.com/watch?v=xvVLWSsKjkI" target="_blank">
                <img src="mago.jpg" class="portada">
            </a>
            <div class="audio-wrapper">
                <audio controls>
                    <source src="audio/fiesta.mp3">
                </audio>
            </div>
        </div>

    </div>
</section>

<section id="videoclips" class="seccion-video">
    <h2>Videoclip</h2>

    <video controls class="video-rockola">
        <source src="videoclip.mp4">
    </video>
</section>

<footer>
    <p>&copy; 2026 El Catatumbo</p>
</footer>

</body>
</html>
